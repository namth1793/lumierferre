# Railway Volume — đặt trùng với Mount Path của Volume trong dashboard (vd: /data)
# Bỏ trống khi chạy local (sẽ dùng backend/data/)
DATA_DIR=

# KiotViet Public API — lấy tại KiotViet: Cài đặt > Cửa hàng > Kết nối API
KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
KIOTVIET_RETAILER=

# Cloudinary — lấy tại Cloudinary Dashboard (cloudinary.com/console)
# Dùng để lưu ảnh sản phẩm & ảnh nội dung website do admin upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Tự động dịch nội dung admin (tiếng Việt) sang giao diện tiếng Anh — điền 1 trong 2 key:
# - Claude (dịch hay nhất, giữ đúng tên thương hiệu/tên mẫu): lấy tại console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# - Hoặc Google Cloud Translation (miễn phí 500.000 ký tự/tháng): bật "Cloud Translation API" trong Google Cloud Console rồi tạo API key
GOOGLE_TRANSLATE_API_KEY=
# Để trống cả hai → dùng Google Translate miễn phí không cần key (dễ bị Google chặn khi dịch nhiều, chỉ nên dùng thử)
